# RPC used by the forge script command; not read by Solidity.
RPC_URL=

# Public Robinhood Chain RPC used by required chain-4663 fork tests.
# ROBINHOOD_MAINNET is the canonical variable and may be overridden with another archive-capable RPC.
ROBINHOOD_MAINNET=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_FORK_BLOCK=14498238
REQUIRE_ROBINHOOD_FORK=false

# Robinhood Chain testnet deployment and pinned dependency fork proof.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_FORK_BLOCK=94803970
REQUIRE_ROBINHOOD_TESTNET_FORK=false
ROBINHOOD_TESTNET_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_VERIFIER_URL=https://explorer.testnet.chain.robinhood.com/api/
BASE_SEPOLIA_RPC_URL=
REQUIRE_DOPPLER_FORK_PROOF=false

# Broadcaster and governance addresses. Never commit a populated private key.
PRIVATE_KEY=
MULTISIG=
GUARDIAN=
TREASURY=

# Standalone Doppler Genesis release. Module addresses are pinned by chain ID.
# These fee/curve values are nonproduction fixtures pending economic ratification.
STATICS_GENESIS_GOVERNANCE=
STATICS_GENESIS_TREASURY=
STATICS_DOPPLER_INTEGRATOR=
STATICS_DOPPLER_SALT=
STATICS_DOPPLER_FEE=30000
STATICS_GENESIS_REWARD_SHARE_BPS=5000
# Configured share (basis points, 0..10000) of harvested WETH routed into the permanent
# Genesis native ETH reserve; the remainder is attributed through the active distributor.
STATICS_GENESIS_RESERVE_SHARE_BPS=5000
# Explicit secured-credit economics. Production values require separate ratification.
STATICS_GENESIS_CREDIT_ORIGINATION_FEE=
STATICS_GENESIS_CREDIT_EXTENSION_FEE=
STATICS_GENESIS_RECOVERY_CALLER_SHARE_BPS=
# Absolute Unix timestamp for the immutable Genesis Epoch end. It must be in the future
# at deployment and is committed into the reviewed launch-configuration hash.
STATICS_GENESIS_EPOCH_END=
STATICS_GENESIS_CONTRACT_URI=
STATICS_GENESIS_EXTERNAL_URL_BASE=
STATICS_GENESIS_FEE_RECEIVER_ADDRESS=
STATICS_TREASURY_VESTING_ADDRESS=
STATICS_GENESIS_ACTIVATION_REGISTRY_ADDRESS=
STATICS_GENESIS_NFT_ADDRESS=
STATICS_GENESIS_VAULT_ADDRESS=
STATICS_GENESIS_DISTRIBUTOR_ADDRESS=

# Owner-operated public-testnet oracle fixtures. ETH/USD uses eight decimals;
# USDG uses 18-decimal WAD. Initial sequencer uptime must exceed the configured
# recovery grace period so the first production-path price read is available.
TESTNET_ORACLE_OWNER=
TESTNET_ETH_USD_INITIAL_PRICE=250000000000
TESTNET_SEQUENCER_INITIAL_UPTIME=3601
TESTNET_USDG_INITIAL_PRICE_WAD=1000000000000000000
TESTNET_USDG_ORACLE_MAX_STALENESS=2592000
TESTNET_USDG_SEQUENCER_GRACE_PERIOD=3600

# Verified deployed ERC-20 used for global protocol staking and rewards.
STAKING_TOKEN=

# Produced by DeployStatics and consumed by the separate timelock ceremony.
STATICS_DIAMOND_ADDRESS=
STATICS_SWAP_FEE_HOOK_ADDRESS=
STATICS_LIQUIDITY_MANAGER_ADDRESS=
STATICS_LIQUIDITY_TIMELOCK_SALT=
STATICS_GENESIS_INTEGRATION_INIT_ADDRESS=
STATICS_GENESIS_HANDOFF_TIMELOCK_SALT=
STATICS_GENESIS_INSTALL_UPGRADE=false
STATICS_GLOBAL_REWARDS_FACET_ADDRESS=
STATICS_POSITION_NFT_FACET_ADDRESS=
STATICS_CUSTODY_FACET_ADDRESS=
STATICS_GENESIS_NFT_FACET_ADDRESS=

# Owner-funded first-basket launch after the liquidity ceremony completes.
STATICS_GENESIS_BASKET_CONFIG=script/config/genesis-basket.example.json
STATICS_GENESIS_TIMELOCK_SALT=

# Fresh testnet faucet inventory. Every address must contain deployed code.
STATICS_FAUCET_USDG=
STATICS_FAUCET_STATICS=
STATICS_FAUCET_TSLA=
STATICS_FAUCET_PLTR=
STATICS_FAUCET_AMD=

# Native-currency price required to create a permissionless basket.
BASKET_CREATION_FEE_AMOUNT=

# Exact native-currency fee for opening any new Position NFT. Zero means free
# creation; it does not disable Position creation.
POSITION_CREATION_FEE_AMOUNT=1000000000000000

# Exact native-currency fee to create a permissionless general Uniswap v4 pool.
# This value is both the anti-spam cost of public market creation and the
# permissionless-creation enable switch: zero disables public general-pool
# creation (owner-only), while any nonzero value requires exact payment from
# every caller. It is independent from the basket and Position creation fees.
POOL_CREATION_FEE_AMOUNT=0

# Verified production dependencies for the initial WETH Dollar profile.
WETH_ADDRESS=
ETH_USD_FEED=
SEQUENCER_UPTIME_FEED=

# Chainlink and sequencer validation parameters.
STATICS_DOLLAR_ORACLE_MAX_STALENESS=
STATICS_DOLLAR_ORACLE_MIN_PRICE_WAD=
STATICS_DOLLAR_ORACLE_MAX_PRICE_WAD=
SEQUENCER_GRACE_PERIOD=

# Initial Statics Dollar risk parameters. Select these before deployment.
STATICS_DOLLAR_COLLATERAL_RATIO_BPS=
STATICS_DOLLAR_PRICE_BAND_BPS=
STATICS_DOLLAR_DEBT_CEILING=
STATICS_DOLLAR_RISK_URI=

# Post-launch mock USDG pegged profile. The existing USDC variable names are
# retained for the current deployment ceremony even though the asset is USDG.
STATICS_DOLLAR_CORE_ADDRESS=
STATICS_DOLLAR_USDC_TIMELOCK_SALT=
STATICS_DOLLAR_USDC_PROFILE_ID=
STATICS_DOLLAR_USDC_TOKEN=
STATICS_DOLLAR_USDC_ORACLE=
STATICS_DOLLAR_USDC_PEG_MIN_PRICE_WAD=
STATICS_DOLLAR_USDC_PEG_MAX_PRICE_WAD=
STATICS_DOLLAR_USDC_MINT_FEE_BPS=
STATICS_DOLLAR_USDC_REDEMPTION_FEE_BPS=
STATICS_DOLLAR_USDC_DEBT_CEILING=
