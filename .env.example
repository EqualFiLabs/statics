# RPC used by the forge script command; not read by Solidity.
RPC_URL=

# Archive-capable Robinhood Chain RPC used by required chain-4663 fork tests.
# ROBINHOOD_MAINNET is canonical; the older name remains a fallback.
ROBINHOOD_MAINNET=
ROBINHOOD_RPC_URL=
ROBINHOOD_FORK_BLOCK=14498238
REQUIRE_ROBINHOOD_FORK=false

# Robinhood Chain testnet deployment and pinned dependency fork proof.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_VERIFIER_URL=https://explorer.testnet.chain.robinhood.com/api/

# Broadcaster and governance addresses. Never commit a populated private key.
PRIVATE_KEY=
MULTISIG=
GUARDIAN=
TREASURY=

# Fixed-supply Statics staking-token deployment inputs.
STATICS_TOKEN_RECIPIENT=
STATICS_TOKEN_INITIAL_SUPPLY=

# Verified deployed ERC-20 used for global protocol staking and rewards.
STAKING_TOKEN=

# Produced by DeployStatics and consumed by the separate timelock ceremony.
STATICS_DIAMOND_ADDRESS=
STATICS_SWAP_FEE_HOOK_ADDRESS=
STATICS_LIQUIDITY_MANAGER_ADDRESS=
STATICS_LIQUIDITY_TIMELOCK_SALT=

# Native-currency price required to create a permissionless basket.
BASKET_CREATION_FEE_AMOUNT=

# Verified production dependencies for the initial WETH Dollar profile.
WETH_ADDRESS=
ETH_USD_FEED=
SEQUENCER_UPTIME_FEED=

# Chainlink and sequencer validation parameters.
STATICS_DOLLAR_ORACLE_MAX_STALENESS=
STATICS_DOLLAR_ORACLE_MIN_PRICE_WAD=
STATICS_DOLLAR_ORACLE_MAX_PRICE_WAD=
SEQUENCER_GRACE_PERIOD=

# Initial Statics Dollar risk parameters. Select these before deployment.
STATICS_DOLLAR_COLLATERAL_RATIO_BPS=
STATICS_DOLLAR_PRICE_BAND_BPS=
STATICS_DOLLAR_DEBT_CEILING=
STATICS_DOLLAR_RISK_URI=
